<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>Fight-club</groupId>
    <artifactId>Fight-Services</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <version>3.5.11</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.16</version>
        </dependency>

        <!-- Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.27.2</version>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>

                <configuration>
                    <source>21</source>
                    <target>21</target>

                    <annotationProcessorPaths>

                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>

                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- JaCoCo -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.10</version>

                <executions>

                    <!-- Activa agente -->
                    <execution>
                        <id>prepare-agent</id>

                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Genera reporte -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>

                        <goals>
                            <goal>report</goal>
                        </goals>

                        <configuration>

                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>

                            <includes>

                                <include>Fight_club/Fight_Services/Application/Services/Action/ClaimHelpButtonImp*</include>
                                <include>Fight_club/Fight_Services/Application/Services/Action/TakeBackControlImp*</include>

                                <include>Fight_club/Fight_Services/Application/Services/Character/**</include>

                                <include>Fight_club/Fight_Services/Application/Services/Fight/**</include>

                                <include>Fight_club/Fight_Services/Infrastructure/Inbound/FightRestController*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Inbound/FightSocketController*</include>

                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/FightCommandListener*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/RoomInitializedListener*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/UserRabbitEventListener*</include>

                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/WebSocket/FightWebSocketUpdater*</include>

                            </includes>

                            <excludes>

                                <exclude>**/dto/**</exclude>
                                <exclude>**/DTO/**</exclude>

                                <exclude>**/event/**</exclude>
                                <exclude>**/Event/**</exclude>

                                <exclude>**/config/**</exclude>
                                <exclude>**/Config/**</exclude>

                                <exclude>**/*Application.class</exclude>

                                <exclude>**/Infrastructure/Outbound/Rabbit/Event/**</exclude>
                                <exclude>**/Infrastructure/Outbound/Rabbit/DTO/**</exclude>
                                <exclude>**/Infrastructure/Outbound/WebSocket/DTO/**</exclude>
                                <exclude>**/Infrastructure/Inbound/DTO/**</exclude>

                                <exclude>Fight_club/Fight_Services/Application/Services/Action/CombatService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Action/AskHelpButtonImp*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightCommandRoutingService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/StartFightImp*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightHistoryService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightOwnershipService*</exclude>
                                <exclude>Fight_club/Fight_Services/Infrastructure/Outbound/WebSocket/FightWebSocketUpdater*</exclude>
                                <exclude>Fight_club/Fight_Services/Infrastructure/Outbound/WebSocket/FightWebSocketUpdater*</exclude>

                            </excludes>

                        </configuration>
                    </execution>

                    <!-- Validación mínima -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>

                        <goals>
                            <goal>check</goal>
                        </goals>

                        <configuration>

                            <rules>
                                <rule>

                                    <element>BUNDLE</element>

                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>

                                </rule>
                            </rules>

                            <includes>

                                <!-- SOLO estas clases de Action -->
                                <include>Fight_club/Fight_Services/Application/Services/Action/ClaimHelpButtonImp*</include>
                                <include>Fight_club/Fight_Services/Application/Services/Action/TakeBackControlImp*</include>

                                <!-- Character -->
                                <include>Fight_club/Fight_Services/Application/Services/Character/**</include>

                                <!-- Fight -->
                                <include>Fight_club/Fight_Services/Application/Services/Fight/**</include>

                                <!-- Controllers -->
                                <include>Fight_club/Fight_Services/Infrastructure/Inbound/FightRestController*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Inbound/FightSocketController*</include>

                                <!-- Rabbit -->
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/FightCommandListener*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/RoomInitializedListener*</include>
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/Rabbit/UserRabbitEventListener*</include>

                                <!-- WebSocket -->
                                <include>Fight_club/Fight_Services/Infrastructure/Outbound/WebSocket/FightWebSocketUpdater*</include>

                            </includes>

                            <excludes>

                                <exclude>**/dto/**</exclude>
                                <exclude>**/DTO/**</exclude>

                                <exclude>**/event/**</exclude>
                                <exclude>**/Event/**</exclude>

                                <exclude>**/config/**</exclude>
                                <exclude>**/Config/**</exclude>

                                <exclude>**/*Application.class</exclude>

                                <exclude>**/Infrastructure/Outbound/Rabbit/Event/**</exclude>
                                <exclude>**/Infrastructure/Outbound/Rabbit/DTO/**</exclude>
                                <exclude>**/Infrastructure/Outbound/WebSocket/DTO/**</exclude>
                                <exclude>**/Infrastructure/Inbound/DTO/**</exclude>

                                <!-- Exclude problematic classes from coverage check -->
                                <exclude>Fight_club/Fight_Services/Application/Services/Action/CombatService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Action/AskHelpButtonImp*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightCommandRoutingService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/StartFightImp*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightHistoryService*</exclude>
                                <exclude>Fight_club/Fight_Services/Application/Services/Fight/FightOwnershipService*</exclude>

                            </excludes>

                        </configuration>
                    </execution>

                </executions>
            </plugin>

        </plugins>
    </build>

</project>